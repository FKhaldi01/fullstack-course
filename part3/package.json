{
  "name": "part3",
  "version": "1.0.0",
  "description": "Phonebook API built with Node.js and Express.",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development node --watch index.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1",
    "lint": "eslint .",
    "build:ui": "rm -rf dist && cd ../part1 && npm run build && cp -r dist ../part3",
    "deploy": "echo 'Deploy to Render'",
    "deploy:full": "npm run build:ui && git add . && git commit -m uibuild && git push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.2.0"
  }
}
